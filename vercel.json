{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/telegram-webhook.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "regions": ["sfo1"],
  "rewrites": [
    { "source": "/api/telegram-webhook", "destination": "/api/telegram-webhook.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ]
}
